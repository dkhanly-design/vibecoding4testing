# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# KHÔNG commit file .env lên Git.

# --- Tài khoản trang quản trị /admin (R-26) ---
ADMIN_USERNAME=admin
# Tối thiểu 12 ký tự. Gợi ý tạo ngẫu nhiên: openssl rand -base64 18
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# --- Database PostgreSQL ---
POSTGRES_USER=dapchuot
# Chỉ dùng chữ và số. Gợi ý: openssl rand -hex 24
POSTGRES_PASSWORD=doi-mat-khau-nay-ngay
POSTGRES_DB=dapchuot

# --- Khác ---
# Đặt 1 khi chạy sau ngrok / reverse proxy (lấy đúng IP người dùng, bật cookie Secure)
TRUST_PROXY=0
